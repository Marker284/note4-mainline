# Minimal AArch32 config for Galaxy Note 4 Exynos (treltexx).
# Used as: make allnoconfig KCONFIG_ALLCONFIG=note4.config
#
# S-Boot puts kernel @0x20008000, DTB @0x21f00000, initrd @0x22000000:
# Image + zImage must fit in ~31 MB, so keep this lean.

# --- core / CPU ---
CONFIG_MMU=y
CONFIG_ARCH_MULTIPLATFORM=y
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_EXYNOS=y
CONFIG_ARCH_EXYNOS5=y
CONFIG_SOC_EXYNOS5433=y
# CONFIG_ARCH_EXYNOS3 is not set
# CONFIG_ARCH_EXYNOS4 is not set
# CONFIG_SOC_EXYNOS5250 is not set
# CONFIG_SOC_EXYNOS5260 is not set
# CONFIG_SOC_EXYNOS5410 is not set
# CONFIG_SOC_EXYNOS5420 is not set
# CONFIG_SOC_EXYNOS5800 is not set
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_HIGHMEM=y
CONFIG_AEABI=y
CONFIG_ARM_THUMB=y
CONFIG_VFP=y
CONFIG_VFPv3=y
CONFIG_NEON=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_CLKSRC_EXYNOS_MCT=y
CONFIG_AUTO_ZRELADDR=y
CONFIG_KERNEL_XZ=y
CONFIG_CMDLINE_FROM_BOOTLOADER=y
CONFIG_ARM_PATCH_PHYS_VIRT=y
CONFIG_HZ_250=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_CPU_IDLE=n

# --- base kernel ---
CONFIG_EXPERT=y
CONFIG_MULTIUSER=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_ELF_CORE=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_POSIX_TIMERS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_CONFIGFS_FS=y
CONFIG_BLOCK=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_PM=y
CONFIG_PM_GENERIC_DOMAINS=y
CONFIG_PM_GENERIC_DOMAINS_OF=y
CONFIG_OF=y

# --- networking (USB NCM + telnet) ---
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y

# --- console / framebuffer ---
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_FB=y
# CONFIG_FB_SIMPLE is not set
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
CONFIG_SERIAL_SAMSUNG=y
CONFIG_SERIAL_SAMSUNG_CONSOLE=y

# --- logs that survive reboot ---
CONFIG_MISC_FILESYSTEMS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# --- SoC plumbing ---
CONFIG_COMMON_CLK_SAMSUNG=y
CONFIG_PINCTRL_EXYNOS=y
CONFIG_EXYNOS_PMU=y
CONFIG_EXYNOS_PM_DOMAINS=y
CONFIG_MFD_SYSCON=y
CONFIG_GPIOLIB=y
CONFIG_I2C=y
CONFIG_I2C_EXYNOS5=y
CONFIG_I2C_GPIO=y
CONFIG_SPI=y
CONFIG_SPI_S3C64XX=y
CONFIG_WATCHDOG=y
CONFIG_S3C2410_WATCHDOG=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_POWER_RESET_SYSCON_POWEROFF=y

# --- PMIC / MUIC ---
CONFIG_MFD_SEC_I2C=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_S2MPS11=y
CONFIG_MFD_MAX77843=y
CONFIG_REGULATOR_MAX77693=y
CONFIG_EXTCON=y
CONFIG_EXTCON_MAX77843=y
CONFIG_POWER_SUPPLY=y

# --- storage ---
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_EXYNOS=y

# --- USB gadget (debug link) ---
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_EXYNOS=y
CONFIG_PHY_EXYNOS5_USBDRD=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ACM=y

# --- input ---
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y

# --- bring-up debugging ---
# S-Boot replaces bootargs with its own, so force ours.
# GPU/Wi-Fi/audio modules are kept from autoloading via /etc/modprobe.d on the device.
CONFIG_CMDLINE="console=tty0 loglevel=7 clk_ignore_unused pd_ignore_unused rdinit=/init printk.devkmsg=on"
CONFIG_CMDLINE_FORCE=y
CONFIG_NOTE4_SECLOG=y

# --- reboot modes (download/recovery) ---
CONFIG_POWER_RESET_SYSCON=y
CONFIG_REBOOT_MODE=y
CONFIG_SYSCON_REBOOT_MODE=y
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set

# --- display: DECON -> MIC -> DSIM -> S6E3HA2 ---
CONFIG_IOMMU_SUPPORT=y
CONFIG_EXYNOS_IOMMU=y
CONFIG_DRM=y
CONFIG_DRM_EXYNOS=y
CONFIG_DRM_EXYNOS5433_DECON=y
CONFIG_DRM_EXYNOS_MIC=y
CONFIG_DRM_EXYNOS_DSI=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_PANEL_SAMSUNG_S6E3HA2=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB_DEVICE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# --- touchscreen ---
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_STMFTS=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y

# --- MIPI DSI D-PHY ---
CONFIG_PHY_EXYNOS_MIPI_VIDEO=y

# --- contiguous memory for 1440x2560 scanout buffers ---
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=128
CONFIG_NOTE4_SMP=y

# --- what a normal (Alpine/OpenRC) userspace expects ---
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_FHANDLE=y
CONFIG_FILE_LOCKING=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_PROC_SYSCTL=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_AUTOFS_FS=y
CONFIG_FUSE_FS=y
CONFIG_SQUASHFS=y
CONFIG_OVERLAY_FS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CPUSETS=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_SECCOMP=y
CONFIG_KALLSYMS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_RAM=y
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_SWAP=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NF_NAT=y
CONFIG_TUN=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_MISC=y
CONFIG_HID=y
CONFIG_HIDRAW=y
CONFIG_USB_HID=y
CONFIG_UHID=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_S5M=y
CONFIG_RTC_DRV_S3C=y
CONFIG_NLS_UTF8=y
CONFIG_EXFAT_FS=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_RD_ZSTD=y
CONFIG_ZSTD_COMPRESS=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPUFREQ_DT=y
CONFIG_THERMAL=y
CONFIG_EXYNOS_THERMAL=y
CONFIG_CPU_THERMAL=y
CONFIG_SCHED_MC=y
CONFIG_PRINTK_TIME=y

# --- pmOS ---
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y

# --- postmarketOS kconfig requirements (pmbootstrap kconfig check) ---
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_XTS=y
CONFIG_DM_CRYPT=y
CONFIG_NLS_ASCII=y
CONFIG_SYN_COOKIES=y
CONFIG_UEVENT_HELPER=y
CONFIG_NULL_TTY=m
CONFIG_MODULE_DECOMPRESS=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_PSI=y
CONFIG_UDMABUF=y
CONFIG_IPC_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_BPF_JIT=y
CONFIG_BPF_LSM=y
CONFIG_FTRACE=y
CONFIG_KPROBE_EVENTS=y
CONFIG_KPROBES=y
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_PATH=y
CONFIG_CRYPTO=y
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_FW_LOADER=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_EVENTS=y
CONFIG_DEBUG_KERNEL=y
CONFIG_PERF_EVENTS=y
CONFIG_HW_PERF_EVENTS=y
CONFIG_UPROBE_EVENTS=y
# BTF breaks in the pmbootstrap cross chroot (resolve_btfids host build)
# CONFIG_DEBUG_INFO_BTF is not set
CONFIG_DEBUG_INFO_NONE=y

# --- battery / charger ---
CONFIG_POWER_SUPPLY=y
CONFIG_BATTERY_MAX17042=y
CONFIG_CHARGER_MAX77843=y

# --- syscalls a normal userspace needs (allnoconfig+EXPERT turns them off) ---
# musl on armv7 calls the 32-bit time syscalls first: without this, touch,
# utimensat, etc. fail with ENOSYS and the pmOS initramfs/systemd break.
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_SYSCTL=y
CONFIG_PROC_SYSCTL=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_IO_URING=y
CONFIG_USERFAULTFD=y
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_CACHESTAT_SYSCALL=y
CONFIG_SYSFS_SYSCALL=y
CONFIG_SGETMASK_SYSCALL=y
# CONFIG_KALLSYMS_ALL is not set
CONFIG_PROC_KCORE=y
CONFIG_PROC_CHILDREN=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_TIME_NS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_PERSISTENT_KEYRINGS=y
CONFIG_KEYS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_AUDIT=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_ELF_CORE=y
CONFIG_BASE_FULL=y
CONFIG_PCSPKR_PLATFORM=y
CONFIG_VM_EVENT_COUNTERS=y
CONFIG_SLUB_DEBUG=y
CONFIG_COMPAT_BRK=n

# classic page tables: note4 early sec_log mapping in head.S assumes non-LPAE
# CONFIG_ARM_LPAE is not set
CONFIG_BLK_DEV=y
CONFIG_DEBUG_FS=y

# capacitive touchkeys (Cypress, as on TM2)
CONFIG_KEYBOARD_TM2_TOUCHKEY=y

# --- audio: WM5110 (SPI) + MAX98504 amp, Samsung TM2 machine driver ---
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SPI_MASTER=y
CONFIG_MFD_ARIZONA=m
CONFIG_MFD_ARIZONA_SPI=m
CONFIG_MFD_WM5110=y
CONFIG_REGULATOR_ARIZONA_LDO1=m
CONFIG_REGULATOR_ARIZONA_MICSUPP=m

CONFIG_GPIO_ARIZONA=m
CONFIG_PINCTRL_ARIZONA=y
CONFIG_SND_SOC_SAMSUNG=m
CONFIG_SND_SAMSUNG_I2S=m
CONFIG_SND_SOC_SAMSUNG_TM2_WM5110=m
CONFIG_SND_SOC_MAX98504=m
CONFIG_SND_SOC_WM5110=m

# --- size: S-Boot window is Image + zImage <= ~31 MiB from 0x20008000 ---
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_FUNCTION_GRAPH_TRACER is not set
# CONFIG_DYNAMIC_FTRACE is not set

# --- Wi-Fi BCM4358 on PCIe (Exynos5433 DesignWare PCIe) ---
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_EXYNOS=y
CONFIG_PHY_EXYNOS_PCIE=y
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PCIE=y

# local builds must report the same release as the pmOS package (no git hash)
# CONFIG_LOCALVERSION_AUTO is not set

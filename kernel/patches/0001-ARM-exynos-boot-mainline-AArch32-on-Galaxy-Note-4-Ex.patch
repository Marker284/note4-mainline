 	/*
 	 * The following calls CPU specific code in a position independent
@@ -169,7 +176,8 @@ ENTRY(stext)
 	ldr	r12, [r10, #PROCINFO_INITFUNC]
 	add	r12, r12, r10
 	ret	r12
-1:	b	__enable_mmu
+1:	note4_mark "note4: [3b] cpu init done, enabling MMU", r3, r5, r6, r7, r10
+	b	__enable_mmu
 ENDPROC(stext)
 	.ltorg
 
@@ -308,6 +316,24 @@ __create_page_tables:
 	addne	r6, r6, #1 << SECTION_SHIFT
 	strne	r6, [r3]
 
+#ifdef CONFIG_NOTE4_SECLOG
+	/*
+	 * Note 4: map the sec_log ring (phys 0x25f00000-0x26200000) at its
+	 * linear address so early markers/printk can use it with the MMU on.
+	 * Assumes PHYS_OFFSET 0x20000000 / PAGE_OFFSET 0xc0000000.
+	 */
+	movw	r0, #((PAGE_OFFSET + 0x05f00000) >> (SECTION_SHIFT - PMD_ENTRY_ORDER)) & 0xffff
+	add	r0, r0, r4
+	movw	r6, #0
+	movt	r6, #0x25f0
+	orr	r6, r6, r7
+	str	r6, [r0], #1 << PMD_ENTRY_ORDER
+	add	r6, r6, #1 << SECTION_SHIFT
+	str	r6, [r0], #1 << PMD_ENTRY_ORDER
+	add	r6, r6, #1 << SECTION_SHIFT
+	str	r6, [r0]
+#endif
+
 #if defined(CONFIG_ARM_LPAE) && defined(CONFIG_CPU_ENDIAN_BE8)
 	sub	r4, r4, #4			@ Fixup page table pointer
 						@ for 64-bit descriptors

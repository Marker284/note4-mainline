diff --git a/arch/arm/mach-exynos/note4-seclog.c b/arch/arm/mach-exynos/note4-seclog.c
new file mode 100644
index 000000000..6964427d8
--- /dev/null
+++ b/arch/arm/mach-exynos/note4-seclog.c
@@ -0,0 +1,93 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Galaxy Note 4 (Exynos5433, AArch32) bring-up console.
+ *
+ * Samsung S-Boot keeps a "LOGM" ring buffer at sec_log=0x200000@0x26000000:
+ *   *(u32 *)(base - 8) = 0x4d474f4c ("LOGM"), *(u32 *)(base - 4) = write ptr.
+ * The downstream recovery kernel copies it to /proc/last_kmsg on boot, so
+ * mirroring printk there gives us the full log after a warm reset.
+ * Every write is cleaned to PoC so it survives a reset without cache flush.
+ */
+#include <linux/console.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/memblock.h>
+#include <linux/string.h>
+#include <asm/cacheflush.h>
+#include <asm/memory.h>
+
+#define SECLOG_BASE	0x26000000UL
+#define SECLOG_SIZE	0x200000UL
+#define SECLOG_MAGIC	0x4d474f4c
+
+#define FB_BASE		0x67000000UL
+#define FB_ROW		(1440 * 4)
+
+static u32 *seclog_mag, *seclog_ptr;
+static char *seclog_buf;
+
+static void seclog_flush(void *p, size_t len)
+{
+	__cpuc_flush_dcache_area(p, len);
+}
+
+static void seclog_write(struct console *con, const char *s, unsigned int n)
+{
+	while (n) {
+		u32 pos = *seclog_ptr & (SECLOG_SIZE - 1);
+		unsigned int chunk = min_t(unsigned int, n, SECLOG_SIZE - pos);
+
+		memcpy(seclog_buf + pos, s, chunk);
+		seclog_flush(seclog_buf + pos, chunk);
+		*seclog_ptr += chunk;
+		s += chunk;
+		n -= chunk;
+	}
+	seclog_flush(seclog_mag, 8);
+}
+
+static struct console seclog_console = {
+	.name	= "seclog",
+	.write	= seclog_write,
+	.flags	= CON_PRINTBUFFER | CON_ENABLED | CON_ANYTIME,
+	.index	= -1,
+};
+
+/* stage marker 2: green band once ioremap works (early_initcall) */
+static int __init note4_paint_green(void)
+{
+	u32 __iomem *fb = ioremap_wc(FB_BASE + FB_ROW * 128, FB_ROW * 128);
+	unsigned int i;
+
+	if (!fb)
+		return 0;
+	for (i = 0; i < FB_ROW * 128 / 4; i++)
+		writel_relaxed(0xff00ff00, fb + i);
+	wmb();
+	iounmap(fb);
+	pr_info("note4: early_initcall reached, green band painted\n");
+	return 0;
+}
+early_initcall(note4_paint_green);
+
+void __init note4_seclog_init(void)
+{
+	char *base;
+
+	memblock_reserve(SECLOG_BASE - PAGE_SIZE, SECLOG_SIZE + PAGE_SIZE);
+	base = phys_to_virt(SECLOG_BASE);
+
+	seclog_mag = (u32 *)(base - 8);
+	seclog_ptr = (u32 *)(base - 4);
+	seclog_buf = base;
+
+	if (*seclog_mag != SECLOG_MAGIC) {
+		*seclog_ptr = 0;
+		*seclog_mag = SECLOG_MAGIC;
+	}
+	seclog_write(NULL, "\n===== note4 mainline seclog =====\n", 35);
+
+	register_console(&seclog_console);
+	pr_info("note4: seclog console at %#lx, ptr=%u\n", SECLOG_BASE, *seclog_ptr);
+}

diff --git a/arch/arm/include/asm/note4-mark.h b/arch/arm/include/asm/note4-mark.h
new file mode 100644
index 000000000..0f2e3f3e0
--- /dev/null
+++ b/arch/arm/include/asm/note4-mark.h
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Galaxy Note 4 bring-up: append a string to Samsung's sec_log ring
+ * (magic "LOGM" @0x25fffff8, ptr @0x25fffffc, 2 MiB ring @0x26000000)
+ * using physical addresses. Only valid with the MMU off.
+ * Clobbers the five scratch registers passed in; no stack, no literals.
+ */
+#ifndef __ASM_NOTE4_MARK_H
+#define __ASM_NOTE4_MARK_H
+
+#ifdef CONFIG_NOTE4_SECLOG
+	.macro	note4_mark msg, rh, rp, rc, rt, rm, hi=0x25ff
+	movw	\rh, #0xfff8
+	movt	\rh, #\hi			@ \rh = &magic
+	movw	\rm, #0x4f4c
+	movt	\rm, #0x4d47			@ "LOGM"
+	ldr	\rc, [\rh]
+	cmp	\rc, \rm
+	movne	\rp, #0
+	strne	\rm, [\rh]
+	strne	\rp, [\rh, #4]
+	ldr	\rp, [\rh, #4]			@ write pointer
+	movw	\rm, #0xffff
+	movt	\rm, #0x001f			@ ring mask
+	adr	\rt, 9997f
+9998:	ldrb	\rc, [\rt], #1
+	cmp	\rc, #0
+	beq	9999f
+	push_mark_byte \rh, \rp, \rc, \rm
+	b	9998b
+9997:	.asciz	"\msg\n"
+	.align	2
+9999:	str	\rp, [\rh, #4]
+	dsb
+	mcr	p15, 0, \rh, c7, c10, 1	@ DCCMVAC: clean header line
+	dsb
+	.endm
+
+	/* store byte \rc at ring[\rp & mask], advance \rp; \rh is preserved */
+	.macro	push_mark_byte rh, rp, rc, rm
+	add	\rh, \rh, #8			@ \rh -> ring base
+	push_mark_store \rh, \rp, \rc, \rm
+	sub	\rh, \rh, #8
+	add	\rp, \rp, #1
+	.endm
+
+	.macro	push_mark_store base, rp, rc, rm
+	and	\rm, \rp, \rm			@ \rm = pos (mask restored below)
+	add	\rm, \base, \rm		@ \rm = byte address
+	strb	\rc, [\rm]
+	dsb
+	mcr	p15, 0, \rm, c7, c10, 1	@ DCCMVAC: push it to RAM
+	movw	\rm, #0xffff
+	movt	\rm, #0x001f
+	.endm
+#else
+	.macro	note4_mark msg, rh, rp, rc, rt, rm, hi=0x25ff
+	.endm
+#endif
+
+#endif

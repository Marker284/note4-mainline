From 94acf96100be36a1316a88fca727bef66c0d0196 Mon Sep 17 00:00:00 2001
From: Marker284 <73433822+Marker284@users.noreply.github.com>
Date: Mon, 23 Nov 2026 12:38:16 +0500
Subject: [PATCH 08/16] mfd: max77843: don't unmask charger/fuel-gauge IRQ
 sources without handlers; charger: mask CHG_INT

Unhandled sources kept INTB asserted and the regmap-irq thread hammered the
PMIC I2C bus forever, hanging everything else on it (seen on Galaxy Note 4).
---
 drivers/mfd/max77843.c                  |  9 ++++++++-
 drivers/power/supply/max77843_charger.c | 13 +++++++++++++
 2 files changed, 21 insertions(+), 1 deletion(-)

diff --git a/drivers/mfd/max77843.c b/drivers/mfd/max77843.c
index 2a48577b1..62c4bd4a4 100644
--- a/drivers/mfd/max77843.c
+++ b/drivers/mfd/max77843.c
@@ -137,10 +137,17 @@ static int max77843_probe(struct i2c_client *i2c)
 		goto err_pmic_id;
 	}
 
+	/*
+	 * Only unmask the sources that have a handler (topsys irq chip and
+	 * the MUIC). The charger and fuel-gauge blocks have no irq chip here,
+	 * so their interrupts would never be cleared and would keep INTB
+	 * asserted, stalling the shared I2C bus with endless regmap-irq reads.
+	 */
 	ret = regmap_update_bits(max77843->regmap,
 				 MAX77843_SYS_REG_INTSRCMASK,
 				 MAX77843_INTSRC_MASK_MASK,
-				 (unsigned int)~MAX77843_INTSRC_MASK_MASK);
+				 MAX77843_INTSRCMASK_CHGR_MASK |
+				 MAX77843_INTSRCMASK_FG_MASK);
 	if (ret < 0) {
 		dev_err(&i2c->dev, "Failed to unmask interrupt source\n");
 		goto err_pmic_id;
diff --git a/drivers/power/supply/max77843_charger.c b/drivers/power/supply/max77843_charger.c
index c481c55e8..50b111b1b 100644
--- a/drivers/power/supply/max77843_charger.c
+++ b/drivers/power/supply/max77843_charger.c
@@ -144,8 +144,21 @@ static int max77843_chg_init_hw(struct max77843_chg *chg)
 {
 	unsigned int cc = min(fast_charge_ma, 3150U) / 50;
 	unsigned int ilim = min(input_limit_ma * 3 / 100, 0x7fU);
+	unsigned int dummy;
 	int ret;
 
+	/*
+	 * The MAX77843 MFD core has no irq chip for the charger block, so
+	 * nobody would ever clear CHG_INT: keep every charger interrupt
+	 * masked and flush the pending ones, otherwise the shared INTB line
+	 * stays asserted and the PMIC I2C bus gets hammered forever. State is
+	 * polled on demand by get_property() instead.
+	 */
+	ret = regmap_write(chg->regmap, MAX77843_CHG_REG_CHG_INT_MASK, 0xff);
+	if (ret)
+		return ret;
+	regmap_read(chg->regmap, MAX77843_CHG_REG_CHG_INT, &dummy);
+
 	ret = regmap_update_bits(chg->regmap, MAX77843_CHG_REG_CHG_CNFG_06,
 				 CNFG_06_CHGPROT, CNFG_06_CHGPROT);
 	if (ret)

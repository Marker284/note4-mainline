// SPDX-License-Identifier: GPL-2.0
/*
 * Samsung Galaxy Note 4 Exynos (SM-N910C/H, "treltexx") — AArch32 build.
 *
 * The stock Samsung bootloader (S-Boot) and secure firmware on this phone
 * only start kernels in AArch32 state, so this file is compiled by the
 * 32-bit ARM kernel (arch/arm) while re-using the arm64 Exynos5433 SoC and
 * TM2 board descriptions: the Note 4 is the same Samsung reference design
 * as the TM2 (S2MPS13, MAX77843, S6E3HA2, STM FTS, WM5110, BCM4358/PCIe).
 */

#include <arm64/exynos/exynos5433-tm2-common.dtsi>

/ {
	model = "Samsung Galaxy Note 4 (SM-N910C/H)";
	compatible = "samsung,treltexx", "samsung,exynos5433";
	chassis-type = "handset";

	/*
	 * S-Boot picks the DTB out of the DTBH image by these properties
	 * (see tools/dtbhtool). Cover every board revision.
	 */
	model_info-chip = <5433>;
	model_info-platform = "trlte";
	model_info-subtype = "trlte_eur_open";
	model_info-hw_rev = <0>;
	model_info-hw_rev_end = <255>;

	/* Hall sensor for the S View / flip cover (low = magnet = closed) */
	hall-sensor {
		compatible = "gpio-keys";
		label = "flip cover";

		switch-lid {
			label = "flip cover";
			gpios = <&gpa0 1 GPIO_ACTIVE_LOW>;
			linux,input-type = <EV_SW>;
			linux,code = <SW_LID>;
			debounce-interval = <15>;
			wakeup-source;
		};
	};

	/* Android secure firmware is not PSCI (see enable-method below). */
	/delete-node/ psci;

	/*
	 * S-Boot rewrites "reg" of the memory node assuming 1 address/size
	 * cell (like the stock DTB), which is garbage with our 2-cell root.
	 * The kernel prefers linux,usable-memory over reg, and S-Boot leaves
	 * it alone. Top 0x980000 is TrustZone (ATAG_MEM ends at 0xdf680000).
	 */
	memory@20000000 {
		linux,usable-memory = <0x0 0x20000000 0x0 0xbf680000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* S-Boot splash framebuffer (s3cfb.bootloaderfb=0x67000000) */
		fb_mem: framebuffer@67000000 {
			reg = <0x0 0x67000000 0x0 0xe10000>;
			no-map;
		};

		/* 0x25fff000-0x26200000: sec_log ring, used by note4-seclog.c */
	};

	chosen {
		/* S-Boot rewrites bootargs; the kernel uses CONFIG_CMDLINE_FORCE. */
		bootargs = "";
	};
};

/* TV/HDMI path unused on the phone. */
&decon_tv {
	status = "disabled";
};

&hdmi {
	status = "disabled";
};

/* panel + DSI PHY supplies must stay up while S-Boot's setup is reused */
/*
 * Samsung S-Boot reboot modes (PMU INFORM3 = 0x12345670 | mode).
 * (Stock also sets INFORM2 = 0x12345678 to skip charge-only mode; a
 * second syscon-reboot-mode instance clashes in sysfs, so not done here.)
 */
&pmu_system_controller {
	reboot-mode-inform3 {
		compatible = "syscon-reboot-mode";
		offset = <0x80c>;
		mode-normal = <0x12345670>;
		mode-download = <0x12345671>;
		mode-upload = <0x12345672>;
		mode-recovery = <0x12345674>;
	};

};

/*
 * The max77693/max77843 CHARGER regulator computes register values relative
 * to its constraint minimum and clamps fast charge to 100 mA at boot;
 * fast-charge/input currents are programmed by max77843-charger instead.
 */
/delete-node/ &charger_reg;

&ldo6_reg {
	regulator-always-on;
};

&ldo7_reg {
	regulator-always-on;
};

&ldo27_reg {
	regulator-always-on;
};

&ldo28_reg {
	regulator-always-on;
};

/*
 * S-Boot may leave the watchdog running (downstream feeds it with a 30 s
 * timeout); mainline exynos5433.dtsi has no node for it, so add one so
 * that s3c2410_wdt can take it over.
 */
&soc {
	watchdog: watchdog@10020000 {
		compatible = "samsung,s3c6410-wdt";
		reg = <0x10020000 0x100>;
		interrupts = <GIC_SPI 101 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&cmu_peris CLK_PCLK_WDT_APOLLO>;
		clock-names = "watchdog";
		timeout-sec = <30>;
	};
};

/* Secondary cores: SYSRAM_NS boot address + PMU power-up (no PSCI). */
&cpu0 {
	enable-method = "samsung,exynos5433-aarch32-smp";
};

&cpu1 {
	enable-method = "samsung,exynos5433-aarch32-smp";
};

&cpu2 {
	enable-method = "samsung,exynos5433-aarch32-smp";
};

&cpu3 {
	enable-method = "samsung,exynos5433-aarch32-smp";
};

&cpu4 {
	enable-method = "samsung,exynos5433-aarch32-smp";
};

&cpu5 {
	enable-method = "samsung,exynos5433-aarch32-smp";
};

&cpu6 {
	enable-method = "samsung,exynos5433-aarch32-smp";
};

&cpu7 {
	enable-method = "samsung,exynos5433-aarch32-smp";
};

/* HDMI is disabled on the phone, so only the WM5110 path for the card */
&{/sound} {
	audio-codec = <&wm5110>;
	i2s-controller = <&i2s0 0>;
};

/*
 * Samsung's Android firmware does not program CNTVOFF on the secondary
 * cores, so the virtual counters of the 8 CPUs disagree by thousands of
 * seconds (wild printk timestamps, 1 s ping RTT, stalls). Use the global
 * physical counter instead.
 */
&timer {
	arm,cpu-registers-not-fw-configured;
};

/*
 * Don't advertise USB 2.0 LPM: the host parks the link in L1 between
 * packets and dwc3 never wakes it to send IN data, so every reply waited
 * for the host's next packet (300-1000 ms ping, ~70 KB/s over NCM).
 */
&usbdrd_dwc3 {
	snps,usb2-gadget-lpm-disable;
};

/*
 * Mali-T760 DVFS: G3D_PLL stays at the 800 MHz S-Boot programs and only the
 * ACLK_G3D divider changes (re-locking the PLL at runtime hangs the SoC), so
 * offer the rates reachable as 800 MHz / n. Voltages follow the mainline
 * table (above the vendor ASV values for this chip).
 */
/* S-Boot leaves G3D_PLL at 266 MHz: set it once at probe, GPU still idle */
&cmu_g3d {
	assigned-clocks = <&cmu_g3d CLK_FOUT_G3D_PLL>;
	assigned-clock-rates = <900000000>;
};

&gpu_opp_table {
	/delete-node/ opp-160000000;
	/delete-node/ opp-267000000;
	/delete-node/ opp-350000000;
	/delete-node/ opp-420000000;
	/delete-node/ opp-500000000;
	/delete-node/ opp-550000000;
	/delete-node/ opp-600000000;
	/delete-node/ opp-700000000;

	/* G3D_PLL fixed at 900 MHz; DVFS only via DIV_G3D (900/n). Volts: stock ASV0 + margin. */
	opp-150000000 {
		opp-hz = /bits/ 64 <150000000>;
		opp-microvolt = <900000>;
	};

	opp-180000000 {
		opp-hz = /bits/ 64 <180000000>;
		opp-microvolt = <900000>;
	};

	opp-225000000 {
		opp-hz = /bits/ 64 <225000000>;
		opp-microvolt = <912500>;
	};

	opp-300000000 {
		opp-hz = /bits/ 64 <300000000>;
		opp-microvolt = <950000>;
	};

	opp-450000000 {
		opp-hz = /bits/ 64 <450000000>;
		opp-microvolt = <1000000>;
	};
};

/* Home button opens/closes the Phosh overview (Super) */
&{/gpio-keys/homepage-key} {
	linux,code = <KEY_LEFTMETA>;
};

&cmu_disp {
	/* same DISP_PLL rate as TM2 (same S6E3HA2 WQHD panel) */
	assigned-clocks = <&cmu_disp CLK_FOUT_DISP_PLL>,
			  <&cmu_mif CLK_DIV_SCLK_DECON_TV_ECLK>,
			  <&cmu_disp CLK_MOUT_ACLK_DISP_333_USER>,
			  <&cmu_disp CLK_MOUT_SCLK_DSIM0_USER>,
			  <&cmu_disp CLK_MOUT_SCLK_DSIM0>,
			  <&cmu_disp CLK_MOUT_SCLK_DECON_ECLK_USER>,
			  <&cmu_disp CLK_MOUT_SCLK_DECON_ECLK>,
			  <&cmu_disp CLK_MOUT_PHYCLK_MIPIDPHY0_RXCLKESC0_USER>,
			  <&cmu_disp CLK_MOUT_PHYCLK_MIPIDPHY0_BITCLKDIV8_USER>,
			  <&cmu_disp CLK_MOUT_DISP_PLL>,
			  <&cmu_mif CLK_MOUT_SCLK_DECON_TV_ECLK_A>,
			  <&cmu_disp CLK_MOUT_SCLK_DECON_TV_ECLK_USER>,
			  <&cmu_disp CLK_MOUT_SCLK_DECON_TV_ECLK>,
			  <&cmu_disp CLK_MOUT_SCLK_DSD_USER>;
	assigned-clock-parents = <0>, <0>,
				 <&cmu_mif CLK_ACLK_DISP_333>,
				 <&cmu_mif CLK_SCLK_DSIM0_DISP>,
				 <&cmu_disp CLK_MOUT_SCLK_DSIM0_USER>,
				 <&cmu_mif CLK_SCLK_DECON_ECLK_DISP>,
				 <&cmu_disp CLK_MOUT_SCLK_DECON_ECLK_USER>,
				 <&cmu_disp CLK_PHYCLK_MIPIDPHY0_RXCLKESC0_PHY>,
				 <&cmu_disp CLK_PHYCLK_MIPIDPHY0_BITCLKDIV8_PHY>,
				 <&cmu_disp CLK_FOUT_DISP_PLL>,
				 <&cmu_mif CLK_MOUT_BUS_PLL_DIV2>,
				 <&cmu_mif CLK_SCLK_DECON_TV_ECLK_DISP>,
				 <&cmu_disp CLK_MOUT_SCLK_DECON_TV_ECLK_USER>,
				 <&cmu_mif CLK_SCLK_DSD_DISP>;
	assigned-clock-rates = <250000000>, <400000000>;
};

&dsi {
	panel@0 {
		compatible = "samsung,s6e3ha2";
		/* retail Note 4 OCTA (ID 40 81 xx): vendor sends BD 11 for touch hsync */
		samsung,touch-hsync-alt;
		reg = <0>;
		vdd3-supply = <&ldo27_reg>;
		vci-supply = <&ldo28_reg>;
		reset-gpios = <&gpg0 0 GPIO_ACTIVE_LOW>;
		enable-gpios = <&gpf1 5 GPIO_ACTIVE_HIGH>;
	};
};

/* Capacitive recent-apps / back keys: same Cypress controller as TM2 */
&hsi2c_9 {
	status = "okay";

	touchkey@20 {
		compatible = "cypress,tm2-touchkey";
		reg = <0x20>;
		interrupt-parent = <&gpa3>;
		interrupts = <2 IRQ_TYPE_EDGE_FALLING>;
		vcc-supply = <&ldo32_reg>;
		vdd-supply = <&ldo33_reg>;
		/* recent-apps -> Super (Phosh overview), back -> Back */
		linux,keycodes = <KEY_LEFTMETA KEY_BACK>;
	};
};

&ldo31_reg {
	regulator-name = "TSP_VDD_1.85V_AP";
	regulator-min-microvolt = <1850000>;
	regulator-max-microvolt = <1850000>;
};

&ldo38_reg {
	regulator-name = "VCC_3.0V_MOTOR_AP";
	regulator-min-microvolt = <3000000>;
	regulator-max-microvolt = <3000000>;
};

/*
 * MAX77843 fuel gauge (MAX17047 ModelGauge core) answers at 0x36 next to
 * the PMIC at 0x66; Note 4 pack is 3220 mAh / 4.35 V, 10 mOhm sense.
 */
&hsi2c_8 {
	fuel-gauge@36 {
		compatible = "maxim,max17047";
		reg = <0x36>;
		maxim,rsns-microohm = <10000>;
		maxim,over-heat-temp = <600>;
		maxim,dead-volt = <3200>;
		maxim,over-volt = <4400>;
	};
};

&stmfts {
	touchscreen-size-x = <1439>;
	touchscreen-size-y = <2559>;
	/* Note 4 FTS firmware: reset via register, interrupt off by default */
	st,needs-int-enable;
};

/* BCM4773 GNSS / sensor hub on SPI0 (driver: sensorhub/bbd.ko + ssp_bbd.ko) */
/*
 * Tell the scheduler the clusters are asymmetric (A53 @1.3 GHz vs A57 @1.9 GHz).
 * Without this both get capacity 1024 and UI threads sit on the slow cores.
 */
&cpu0 { capacity-dmips-mhz = <578>; };
&cpu1 { capacity-dmips-mhz = <578>; };
&cpu2 { capacity-dmips-mhz = <578>; };
&cpu3 { capacity-dmips-mhz = <578>; };
&cpu4 { capacity-dmips-mhz = <1024>; };
&cpu5 { capacity-dmips-mhz = <1024>; };
&cpu6 { capacity-dmips-mhz = <1024>; };
&cpu7 { capacity-dmips-mhz = <1024>; };

#include "exynos5433-treltexx-sensorhub.dtsi"

# Config: linux-postmarketos-exynos5 + kernel/note4.config (merge_config.sh).
# Mainline kernel for Galaxy Note 4 Exynos (Exynos5433) running in AArch32:
# the stock S-Boot/secure firmware cannot start arm64 kernels.
pkgname=linux-samsung-treltexx
pkgver=7.3.5
pkgrel=11
pkgdesc="Galaxy Note 4 Exynos mainline kernel (AArch32)"
arch="armv7"
_carch="arm"
_flavor="samsung-treltexx"
url="https://kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	bison
	elfutils-dev
	linux-headers
	pahole
	clang
	findutils
	flex
	lld
	llvm
	openssl-dev
	perl
	python3
	postmarketos-installkernel
	xz
	zstd
"

_config="config-$_flavor.$arch"
source="
	https://cdn.kernel.org/pub/linux/kernel/v${pkgver%%.*}.x/linux-$pkgver.tar.xz
	0001-ARM-exynos-boot-mainline-AArch32-on-Galaxy-Note-4-Ex.patch
	0002-ARM-exynos-Exynos5433-AArch32-SMP-bring-up-via-SYSRA.patch
	0003-ARM-dts-samsung-add-Galaxy-Note-4-treltexx-Exynos543.patch
	0004-Input-stmfts-support-firmwares-needing-register-rese.patch
	0005-power-supply-add-minimal-MAX77843-charger-driver-stm.patch
	0006-drm-panel-s6e3ha2-pick-touch-hsync-variant-by-panel-.patch
	0007-ARM-compressed-put-Note-4-decompressor-markers-behin.patch
	0008-mfd-max77843-don-t-unmask-charger-fuel-gauge-IRQ-sou.patch
	0009-ARM-dts-treltexx-Cypress-touchkeys-WM5110-only-sound.patch
	0010-ARM-dts-treltexx-use-the-physical-arch-timer-firmwar.patch
	0011-ARM-dts-treltexx-disable-USB2-LPM-in-gadget-mode-NCM.patch
	0012-ARM-dts-treltexx-cap-Mali-T760-at-267-MHz-TM2-OPP-vo.patch
	0013-ARM-dts-treltexx-hall-sensor-flip-cover-as-SW_LID.patch
	0014-ARM-dts-treltexx-Home-and-recent-apps-keys-Super-Pho.patch
	0015-clk-samsung-exynos5433-don-t-propagate-GPU-rate-chan.patch
	0016-ARM-dts-treltexx-BCM4773-sensor-hub-CPU-capacities-G.patch
	$_config
	mkdtbh.py
"
builddir="$srcdir/linux-$pkgver"

prepare() {
	default_prepare
	cp "$srcdir/$_config" .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 olddefconfig
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-postmarketOS"
}

package() {
	mkdir -p "$pkgdir"/boot
	make zinstall modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	rm -f "$pkgdir"/usr/lib/modules/*/build

	# Samsung DTBH dt.img with this S-Boot's fixed platform/subtype codes
	python3 "$srcdir"/mkdtbh.py -o "$pkgdir"/boot/dt.img \
		--chip 5433 --platform 0x3ec3 --subtype 0x3a37307e --rev 0:255 \
		"$pkgdir"/boot/dtbs/exynos5433-treltexx.dtb

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

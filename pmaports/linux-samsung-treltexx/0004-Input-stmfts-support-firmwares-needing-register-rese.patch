From be0e5a6a508a3f3d1269aa16a3c017163e665b25 Mon Sep 17 00:00:00 2001
From: Marker284 <73433822+Marker284@users.noreply.github.com>
Date: Mon, 23 Nov 2026 12:38:15 +0500
Subject: [PATCH 04/16] Input: stmfts - support firmwares needing register
 reset and host interrupt enable (Galaxy Note 4)

---
 .../boot/dts/samsung/exynos5433-treltexx.dts  |  2 +
 drivers/input/touchscreen/stmfts.c            | 45 ++++++++++++++++++-
 2 files changed, 46 insertions(+), 1 deletion(-)

diff --git a/arch/arm/boot/dts/samsung/exynos5433-treltexx.dts b/arch/arm/boot/dts/samsung/exynos5433-treltexx.dts
index 855a4df75..add5c1fd4 100644
--- a/arch/arm/boot/dts/samsung/exynos5433-treltexx.dts
+++ b/arch/arm/boot/dts/samsung/exynos5433-treltexx.dts
@@ -209,4 +209,6 @@ &ldo38_reg {
 &stmfts {
 	touchscreen-size-x = <1439>;
 	touchscreen-size-y = <2559>;
+	/* Note 4 FTS firmware: reset via register, interrupt off by default */
+	st,needs-int-enable;
 };
diff --git a/drivers/input/touchscreen/stmfts.c b/drivers/input/touchscreen/stmfts.c
index 972687797..03e64aa16 100644
--- a/drivers/input/touchscreen/stmfts.c
+++ b/drivers/input/touchscreen/stmfts.c
@@ -103,6 +103,7 @@ struct stmfts_data {
 	struct completion cmd_done;
 
 	bool use_key;
+	bool needs_int_enable;
 	bool led_status;
 	bool hover_enabled;
 	bool running;
@@ -552,11 +553,52 @@ static void stmfts_reset(struct stmfts_data *sdata)
 	msleep(50);
 }
 
+/*
+ * Some firmwares (e.g. the one on the Galaxy Note 4) reject the 0xa0 reset
+ * command and keep the interrupt line disabled until the host sets it in
+ * register 0x001c, so reset through the register interface instead.
+ */
+static int stmfts_write_reg(struct stmfts_data *sdata, u8 reg, u8 val)
+{
+	u8 buf[4] = { 0xb6, 0x00, reg, val };
+	int ret;
+
+	ret = i2c_master_send(sdata->client, buf, sizeof(buf));
+	if (ret < 0)
+		return ret;
+	return ret == sizeof(buf) ? 0 : -EIO;
+}
+
+static int stmfts_reset_enable_int(struct stmfts_data *sdata)
+{
+	int err;
+
+	reinit_completion(&sdata->cmd_done);
+
+	err = stmfts_write_reg(sdata, 0x23, 0x01);	/* system reset */
+	if (err)
+		return err;
+	msleep(20);
+
+	err = stmfts_write_reg(sdata, 0x1c, 0x41);	/* interrupt enable */
+	if (err)
+		return err;
+
+	if (!wait_for_completion_timeout(&sdata->cmd_done,
+					 msecs_to_jiffies(1000)))
+		dev_warn(&sdata->client->dev,
+			 "no controller-ready event after reset\n");
+	return 0;
+}
+
 static int stmfts_configure(struct stmfts_data *sdata)
 {
 	int err;
 
-	err = stmfts_command(sdata, STMFTS_SYSTEM_RESET);
+	if (sdata->needs_int_enable)
+		err = stmfts_reset_enable_int(sdata);
+	else
+		err = stmfts_command(sdata, STMFTS_SYSTEM_RESET);
 	if (err)
 		return err;
 
@@ -716,6 +758,7 @@ static int stmfts_probe(struct i2c_client *client)
 	input_set_abs_params(sdata->input, ABS_MT_PRESSURE, 0, 255, 0, 0);
 	input_set_abs_params(sdata->input, ABS_DISTANCE, 0, 255, 0, 0);
 
+	sdata->needs_int_enable = device_property_read_bool(dev, "st,needs-int-enable");
 	sdata->use_key = device_property_read_bool(dev, "touch-key-connected");
 	if (sdata->use_key) {
 		input_set_capability(sdata->input, EV_KEY, KEY_MENU);
-- 
